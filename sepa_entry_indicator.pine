//@version=5
indicator("Multibagger SEPA Entry", shorttitle = "SEPA Entry", overlay = true, max_labels_count = 500)

// Trend template inputs.
smaFastLen = input.int(50, "Fast SMA", minval = 1, group = "Trend Template")
smaMidLen = input.int(150, "Mid SMA", minval = 1, group = "Trend Template")
smaSlowLen = input.int(200, "Slow SMA", minval = 1, group = "Trend Template")
smaMidSlopeLookback = input.int(21, "Mid SMA rising lookback", minval = 1, group = "Trend Template")
smaSlowSlopeLookback = input.int(21, "Slow SMA rising lookback", minval = 1, group = "Trend Template")
highLowLen = input.int(252, "52-week lookback bars", minval = 100, group = "Trend Template")
minAboveLowPct = input.float(30.0, "Min % above 52-week low", minval = 0.0, step = 0.5, group = "Trend Template")
maxBelowHighPct = input.float(25.0, "Max % below 52-week high", minval = 0.0, step = 0.5, group = "Trend Template")

// RS is a per-chart proxy, not a universe percentile rank.
useRsFilter = input.bool(true, "Require RS proxy", group = "Relative Strength")
benchmarkSymbol = input.symbol("NSE:NIFTY", "Benchmark", group = "Relative Strength")
rsLookback = input.int(63, "RS performance lookback", minval = 10, group = "Relative Strength")
rsHighLookback = input.int(252, "RS line high lookback", minval = 50, group = "Relative Strength")
rsNearHighPct = input.float(90.0, "RS line within % of high", minval = 1.0, maxval = 100.0, step = 1.0, group = "Relative Strength")
rsMinOutperformancePct = input.float(0.0, "Min outperformance vs benchmark %", step = 0.25, group = "Relative Strength")

// Practical VCP inputs.
baseLookback = input.int(65, "Base lookback", minval = 20, group = "Practical VCP")
maxBaseDepthPct = input.float(35.0, "Max base depth %", minval = 1.0, step = 0.5, group = "Practical VCP")
tightRangeLen = input.int(10, "Tight range bars", minval = 3, group = "Practical VCP")
maxTightRangePct = input.float(12.0, "Max tight range %", minval = 0.5, step = 0.25, group = "Practical VCP")
requireProgressiveContraction = input.bool(true, "Require progressive range contraction", group = "Practical VCP")
volumeDryupLen = input.int(10, "Dry-up volume SMA", minval = 2, group = "Practical VCP")
volumeAvgLen = input.int(50, "Average volume SMA", minval = 5, group = "Practical VCP")
volumeDryupMult = input.float(0.80, "Dry-up max x average volume", minval = 0.1, step = 0.05, group = "Practical VCP")
atrLen = input.int(14, "ATR length", minval = 1, group = "Practical VCP")
atrAvgLen = input.int(50, "ATR average length", minval = 5, group = "Practical VCP")
requireAtrContraction = input.bool(true, "Require ATR contraction", group = "Practical VCP")

// Watch and breakout inputs.
pivotLookback = input.int(20, "Pivot lookback", minval = 5, group = "Watch / Buy")
breakoutMaLen = input.int(20, "Breakout short MA", minval = 1, group = "Watch / Buy")
nearPivotPct = input.float(5.0, "WATCH distance below pivot %", minval = 0.1, step = 0.25, group = "Watch / Buy")
breakoutBufferPct = input.float(0.10, "Breakout buffer %", minval = 0.0, step = 0.05, group = "Watch / Buy")
breakoutVolumeMult = input.float(1.50, "Breakout volume x average", minval = 1.0, step = 0.05, group = "Watch / Buy")
confirmOnClose = input.bool(true, "Confirm signals on bar close", group = "Watch / Buy")

// Risk guide inputs.
stopLookback = input.int(10, "Structure stop lookback", minval = 2, group = "Entry Risk")
stopAtrMult = input.float(2.0, "ATR stop multiple", minval = 0.1, step = 0.1, group = "Entry Risk")
maxRiskPct = input.float(8.0, "Max entry risk %", minval = 0.5, step = 0.25, group = "Entry Risk")

// Visual inputs.
showMovingAverages = input.bool(true, "Show moving averages", group = "Visuals")
showPivotAndStop = input.bool(true, "Show pivot and stop", group = "Visuals")
showStatusTable = input.bool(true, "Show status table", group = "Visuals")
colorSignalBars = input.bool(true, "Color signal bars", group = "Visuals")

// ── helpers ──────────────────────────────────────────────────────────────────
rangePct(highSeries, lowSeries, len) =>
    rangeValue = ta.highest(highSeries, len) - ta.lowest(lowSeries, len)
    close > 0.0 ? rangeValue / close * 100.0 : na

statusColor(pass) =>
    pass ? color.new(color.lime, 0) : color.new(color.red, 30)

statusText(pass) =>
    pass ? "✓" : "✗"

// ── trend template ────────────────────────────────────────────────────────────
smaFast = ta.sma(close, smaFastLen)
smaMid  = ta.sma(close, smaMidLen)
smaSlow = ta.sma(close, smaSlowLen)
smaBreakout = ta.sma(close, breakoutMaLen)
high52 = ta.highest(high, highLowLen)
low52  = ta.lowest(low,  highLowLen)
hasTrendHistory = not na(smaFast) and not na(smaMid) and not na(smaSlow) and not na(smaMid[smaMidSlopeLookback]) and not na(smaSlow[smaSlowSlopeLookback]) and not na(high52) and not na(low52)

ttPriceAboveMas = hasTrendHistory and close > smaFast and close > smaMid and close > smaSlow
ttSmaStack       = hasTrendHistory and smaFast > smaMid and smaMid > smaSlow
ttMidRising      = hasTrendHistory and smaMid > smaMid[smaMidSlopeLookback]
ttSlowRising     = hasTrendHistory and smaSlow > smaSlow[smaSlowSlopeLookback]
ttAboveLow       = hasTrendHistory and close >= low52  * (1.0 + minAboveLowPct  / 100.0)
ttNearHigh       = hasTrendHistory and close >= high52 * (1.0 - maxBelowHighPct / 100.0)
trendTemplatePass = ttPriceAboveMas and ttSmaStack and ttMidRising and ttSlowRising and ttAboveLow and ttNearHigh

// ── relative strength ─────────────────────────────────────────────────────────
benchmarkClose = request.security(benchmarkSymbol, timeframe.period, close, ignore_invalid_symbol = true)
rsAvailable  = not na(benchmarkClose) and benchmarkClose > 0.0 and not na(benchmarkClose[rsLookback]) and benchmarkClose[rsLookback] > 0.0
rsLine       = rsAvailable ? close / benchmarkClose : na
stockPerf    = not na(close[rsLookback]) and close[rsLookback] > 0.0 ? close / close[rsLookback] - 1.0 : na
benchmarkPerf = rsAvailable ? benchmarkClose / benchmarkClose[rsLookback] - 1.0 : na
rsLineHigh   = ta.highest(rsLine, rsHighLookback)
rsOutperform = rsAvailable and not na(stockPerf) and not na(benchmarkPerf) and stockPerf >= benchmarkPerf + rsMinOutperformancePct / 100.0
rsNearOwnHigh = rsAvailable and not na(rsLineHigh) and rsLine >= rsLineHigh * (rsNearHighPct / 100.0)
rsPass = not useRsFilter or (rsOutperform and rsNearOwnHigh)

// ── practical VCP ─────────────────────────────────────────────────────────────
baseHigh = ta.highest(high, baseLookback)
baseLow  = ta.lowest(low,  baseLookback)
baseDepthPct = baseHigh > 0.0 ? (baseHigh - baseLow) / baseHigh * 100.0 : na
baseDepthOk  = not na(baseDepthPct) and baseDepthPct <= maxBaseDepthPct

recentRangePct = rangePct(high, low, tightRangeLen)
priorRangePct  = rangePct(high[tightRangeLen], low[tightRangeLen], tightRangeLen)
olderRangePct  = rangePct(high[tightRangeLen * 2], low[tightRangeLen * 2], tightRangeLen)
rangeTight       = not na(recentRangePct) and recentRangePct <= maxTightRangePct
rangeContracting = not requireProgressiveContraction or (not na(recentRangePct) and not na(priorRangePct) and not na(olderRangePct) and recentRangePct < priorRangePct and priorRangePct < olderRangePct)

volAvg      = ta.sma(volume, volumeAvgLen)
volDry      = ta.sma(volume, volumeDryupLen)
volumeDryup = not na(volAvg) and volAvg > 0.0 and not na(volDry) and volDry <= volAvg * volumeDryupMult

atr        = ta.atr(atrLen)
atrPct     = close > 0.0 ? atr / close * 100.0 : na
atrPctAvg  = ta.sma(atrPct, atrAvgLen)
atrContracting = not requireAtrContraction or (not na(atrPct) and not na(atrPctAvg) and atrPct < atrPctAvg)

basePosition   = baseHigh > baseLow ? (close - baseLow) / (baseHigh - baseLow) : na
upperHalfOfBase = not na(basePosition) and basePosition >= 0.50
vcpPass = baseDepthOk and rangeTight and rangeContracting and volumeDryup and atrContracting and upperHalfOfBase

// ── pivot, entry and stop ─────────────────────────────────────────────────────
pivot         = ta.highest(high[1], pivotLookback)
entryPrice    = pivot * (1.0 + breakoutBufferPct / 100.0)
structureStop = ta.lowest(low, stopLookback)
atrStop       = entryPrice - atr * stopAtrMult
maxRiskStop   = entryPrice * (1.0 - maxRiskPct / 100.0)
stopGuide     = math.max(math.max(structureStop, atrStop), maxRiskStop)
riskPct       = entryPrice > 0.0 ? (entryPrice - stopGuide) / entryPrice * 100.0 : na

nearPivot       = not na(pivot) and close < entryPrice and close >= pivot * (1.0 - nearPivotPct / 100.0)
breakoutPrice   = not na(entryPrice) and close > entryPrice and close[1] <= nz(entryPrice[1], entryPrice)
breakoutVolume  = not na(volAvg) and volAvg > 0.0 and volume >= volAvg * breakoutVolumeMult
breakoutMomentum = not na(smaBreakout) and close > smaBreakout
confirmed = not confirmOnClose or barstate.isconfirmed

watchSignal = confirmed and trendTemplatePass and rsPass and vcpPass and nearPivot
buySignal   = confirmed and trendTemplatePass and rsPass and vcpPass and breakoutPrice and breakoutVolume and breakoutMomentum

// ── moving averages ───────────────────────────────────────────────────────────
plot(showMovingAverages ? smaFast : na, "SMA 50",  color = #0277bd, linewidth = 2)
plot(showMovingAverages ? smaMid  : na, "SMA 150", color = #e65100, linewidth = 2)
plot(showMovingAverages ? smaSlow : na, "SMA 200", color = #6a1b9a, linewidth = 3)

// ── pivot / entry / stop lines — only on actual signal bars, not all nearPivot bars ──
// This prevents scattered dashes cluttering the chart history.
showLines = showPivotAndStop and (watchSignal or buySignal)

plot(showLines ? entryPrice : na, "Entry",      color = #01579b, linewidth = 3, style = plot.style_linebr)
plot(showLines ? stopGuide  : na, "Stop guide", color = #b71c1c, linewidth = 3, style = plot.style_linebr)

// ── signal shapes ─────────────────────────────────────────────────────────────
plotshape(watchSignal, title = "WATCH",
     style = shape.triangleup, location = location.belowbar,
     color = #1565c0, textcolor = color.white,
     text = "WATCH", size = size.large)

plotshape(buySignal, title = "BUY",
     style = shape.labelup, location = location.belowbar,
     color = #1b5e20, textcolor = color.white,
     text = "BUY", size = size.huge)

// ── bar coloring ──────────────────────────────────────────────────────────────
barcolor(colorSignalBars ? buySignal ? color.new(#1b5e20, 0) : watchSignal ? color.new(#1565c0, 0) : na : na)

// ── alerts ────────────────────────────────────────────────────────────────────
alertcondition(watchSignal, title = "SEPA WATCH", message = "SEPA WATCH on {{ticker}} {{interval}}. Price is near pivot with trend, RS and VCP checks passing.")
alertcondition(buySignal,   title = "SEPA BUY",   message = "SEPA BUY on {{ticker}} {{interval}}. Breakout above pivot with required volume.")

// ── status table ──────────────────────────────────────────────────────────────
C_BG     = color.new(#1c1c1c, 0)
C_BG_HDR = color.new(#111111, 0)
C_TEXT   = color.new(#f0f0f0, 0)
C_BORDER = color.new(#555555, 0)
C_PASS   = color.new(#69f0ae, 0)
C_FAIL   = color.new(#ff5252, 0)

var table statusTable = table.new(position.top_right, 2, 9,
     border_width = 1, border_color = C_BORDER,
     frame_width = 2, frame_color = C_BORDER)

if showStatusTable and barstate.islast
    // header
    table.cell(statusTable, 0, 0, "SEPA",        text_color = color.white, bgcolor = C_BG_HDR, text_size = size.normal)
    table.cell(statusTable, 1, 0, syminfo.ticker, text_color = #64b5f6,    bgcolor = C_BG_HDR, text_size = size.normal)

    // checklist rows — tells you exactly which condition is blocking a signal
    table.cell(statusTable, 0, 1, "Trend",      text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 1, statusText(trendTemplatePass), text_color = trendTemplatePass ? C_PASS : C_FAIL, bgcolor = C_BG, text_size = size.normal)

    table.cell(statusTable, 0, 2, "RS",         text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 2,
         useRsFilter and not rsAvailable ? "N/A" : statusText(rsPass),
         text_color = useRsFilter and not rsAvailable ? color.orange : rsPass ? C_PASS : C_FAIL,
         bgcolor = C_BG, text_size = size.normal)

    table.cell(statusTable, 0, 3, "VCP",        text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 3, statusText(vcpPass), text_color = vcpPass ? C_PASS : C_FAIL, bgcolor = C_BG, text_size = size.normal)

    table.cell(statusTable, 0, 4, "Nr Pivot",   text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 4, statusText(nearPivot), text_color = nearPivot ? C_PASS : C_FAIL, bgcolor = C_BG, text_size = size.normal)

    table.cell(statusTable, 0, 5, "Vol",        text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 5, statusText(breakoutVolume), text_color = breakoutVolume ? C_PASS : C_FAIL, bgcolor = C_BG, text_size = size.normal)

    table.cell(statusTable, 0, 6, "Risk",       text_color = C_TEXT, bgcolor = C_BG, text_size = size.normal)
    table.cell(statusTable, 1, 6,
         not na(riskPct) ? str.tostring(riskPct, "#.#") + "%" : "—",
         text_color = not na(riskPct) and riskPct <= maxRiskPct ? C_PASS : color.orange,
         bgcolor = C_BG, text_size = size.normal)

    // state badge
    _stateBg  = buySignal ? color.new(#1b5e20, 0) : watchSignal ? color.new(#0d47a1, 0) : color.new(#333333, 0)
    _stateStr = buySignal ? "BUY" : watchSignal ? "WATCH" : "WAIT"
    _stateCol = buySignal ? #69f0ae : watchSignal ? #90caf9 : #9e9e9e
    table.cell(statusTable, 0, 7, "State",   text_color = C_TEXT,   bgcolor = _stateBg, text_size = size.normal)
    table.cell(statusTable, 1, 7, _stateStr, text_color = _stateCol, bgcolor = _stateBg, text_size = size.normal)
